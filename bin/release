#!/bin/bash
set -euo pipefail

# Releases what main already holds: checks, builds and verifies the universal
# binary, then tags it and publishes the GitHub release. It commits nothing.
# The version bump and its notes land on development first (bin/bump), and
# main is fast-forwarded to development before this runs.
#
# Usage: bin/release [--dry-run]
#
#   --dry-run   Everything up to the tag, then print the release description.
#
# Run it again after a failure: it finishes the tag, its push or the GitHub
# release that an earlier run left undone.

BINARY="claude-persona"
BUILD_DIR="build"
RELEASE_DIR="releases"
REPO="kellyredding/claude-persona"

dry_run=false
case "${1:-}" in
  "") ;;
  --dry-run) dry_run=true ;;
  *) echo "usage: bin/release [--dry-run]" >&2; exit 2 ;;
esac

die() { echo "Error: $*" >&2; exit 1; }

cd "$(dirname "$0")/.."

# --- Preflight: everything that can refuse, before the slow part -------------

# The build compiles Apple Silicon natively and cross-compiles Intel.
[ "$(uname -s)" = "Darwin" ] && [ "$(uname -m)" = "arm64" ] \
  || die "releases are built on an Apple Silicon Mac; this is $(uname -s) on $(uname -m)."
command -v gh >/dev/null || die "the GitHub CLI (gh) is not installed."

branch=$(git rev-parse --abbrev-ref HEAD)
[ "$branch" = "main" ] \
  || die "releases are made from main (currently on $branch). Fast-forward main to development, push it, then release."
[ -z "$(git status --porcelain)" ] || die "the working tree has changes; a release is made from what main holds."
git fetch --quiet origin main
[ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] \
  || die "main is not origin/main. Push main (or pull it) first."

version=$(tr -d '[:space:]' < VERSION.txt)
[[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "VERSION.txt holds '$version', not a version like 1.2.3."
shard_version=$(sed -n 's/^version: //p' shard.yml)
[ "$shard_version" = "$version" ] \
  || die "shard.yml says $shard_version, VERSION.txt says $version. Run bin/bump $version on development."
# A fixture with no version line (the invalid-TOML one) has nothing to match.
for f in spec/fixtures/personas/*.toml; do
  fixture_version=$(sed -n 's/^version = "\(.*\)"$/\1/p' "$f")
  [ -z "$fixture_version" ] || [ "$fixture_version" = "$version" ] \
    || die "$f says $fixture_version, VERSION.txt says $version. Run bin/bump $version on development."
done

notes="release-notes/v$version.md"
[ -s "$notes" ] || die "no release notes at $notes. Write them in the version-bump commit on development."

tag="v$version"
head=$(git rev-parse HEAD)
if git rev-parse -q --verify "refs/tags/$tag" >/dev/null; then
  [ "$(git rev-parse "$tag^{commit}")" = "$head" ] \
    || die "$tag already exists on another commit. Bump the version on development."
fi

# One universal binary for every Mac. Releases up to 1.6.0 named the
# architecture (darwin-arm64, darwin-amd64); scripts/update.sh still finds those.
artifact="$BINARY-$version-darwin"

echo "==> Releasing claude-persona $version ($(git rev-parse --short=12 HEAD))"

# --- Check, build, verify ----------------------------------------------------

echo "==> Running every check (make check)"
make check >/dev/null 2>&1 || die "make check failed; run it to see why."
# make check formats the source, so a change here means main was not formatted.
[ -z "$(git status --porcelain)" ] || die "make check changed the tree (it formats the source). Commit the formatting on development."

echo "==> Building the universal release binary"
make build >/dev/null 2>&1 || die "make build failed; run it to see why."

# Before anything is tagged: a binary missing an architecture or built for a
# newer macOS would fail only on the Mac it was meant for.
echo "==> Verifying the release binary"
bin/verify-binary "$BUILD_DIR/$BINARY"
have=$("$BUILD_DIR/$BINARY" version)
[ "$have" = "$version" ] || die "the binary reports $have, not $version."

echo "==> Packaging"
mkdir -p "$RELEASE_DIR"
rm -f "$RELEASE_DIR/$artifact" "$RELEASE_DIR/$artifact.tar.gz" "$RELEASE_DIR/$artifact.tar.gz.sha256"
cp "$BUILD_DIR/$BINARY" "$RELEASE_DIR/$artifact"
(cd "$RELEASE_DIR" && tar -czf "$artifact.tar.gz" "$artifact" \
  && shasum -a 256 "$artifact.tar.gz" > "$artifact.tar.gz.sha256" \
  && rm "$artifact")

description="$RELEASE_DIR/$artifact.notes.md"
{
  echo "Update an existing install with \`claude-persona update\`."
  echo
  echo "One universal binary for macOS 15 or later, on Apple Silicon or Intel."
  echo "To install by hand, see the README."
  echo
  echo "## What's new"
  echo
  cat "$notes"
} > "$description"

if $dry_run; then
  echo "==> Dry run: stopping before the tag. Archive: $RELEASE_DIR/$artifact.tar.gz"
  echo "==> The release description would be:"
  echo
  cat "$description"
  exit 0
fi

# --- Tag and publish ---------------------------------------------------------

if git rev-parse -q --verify "refs/tags/$tag" >/dev/null; then
  echo "==> $tag already points at this commit"
else
  echo "==> Tagging $tag"
  git tag -a "$tag" -m "Release $version"
fi
echo "==> Pushing $tag"
git push --quiet origin "$tag"

if gh release view "$tag" --repo "$REPO" >/dev/null 2>&1; then
  echo "==> Finishing the existing GitHub release"
  gh release upload "$tag" --repo "$REPO" --clobber \
    "$RELEASE_DIR/$artifact.tar.gz" "$RELEASE_DIR/$artifact.tar.gz.sha256"
  gh release edit "$tag" --repo "$REPO" --title "v$version" --notes-file "$description" --draft=false --latest >/dev/null
else
  echo "==> Publishing the GitHub release"
  gh release create "$tag" --repo "$REPO" --title "v$version" --notes-file "$description" --latest \
    "$RELEASE_DIR/$artifact.tar.gz" "$RELEASE_DIR/$artifact.tar.gz.sha256"
fi

echo ""
echo "==> Released $tag"
echo "    https://github.com/$REPO/releases/tag/$tag"
